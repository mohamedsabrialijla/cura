APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# للإنتاج (مهم لمشاركة الواتساب وفيسبوك): APP_URL=https://keepersport.sa

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="${APP_URL}"

# Nafath (نفاذ) - الرابط لا يفتح في المتصفح، يُستدعى من السيرفر فقط
# NAFATH_AUTHORIZE_URL=https://rabet-nafath.api.elm.sa/nafath/api/v1/client/authorize/
# NAFATH_APP_ID=   إن طلبته وثيقة ELM/نفاذ
# NAFATH_API_KEY=your_api_key
# NAFATH_CALLBACK_URL=https://www.brandy.sa/nafath/post-callback

# كاش أقوى لكتالوج Keepersport: يُفضّل Redis للحجم الكبير (بدل جدول cache في SQLite/MySQL)
# CACHE_STORE=redis
# KEEPERSPORT_CACHE_STORE=redis
#
# مهم: لا تخفّض PRODUCTS/CATALOG/SLUG لأقل من ساعات — وإلا اليوم التالي الصفحات تبرد وتبطئ
# KEEPERSPORT_CATALOG_CACHE_TTL=86400
# KEEPERSPORT_PRODUCTS_CACHE_TTL=86400
# KEEPERSPORT_PRODUCT_SLUG_CACHE_TTL=86400
# KEEPERSPORT_CATALOG_STALE_TTL=259200
# KEEPERSPORT_PRODUCTS_LIST_STALE_TTL=172800
# KEEPERSPORT_CATALOG_LOCK_WAIT=300
# KEEPERSPORT_HTTP_CATALOG_MAX_AGE=0
# KEEPERSPORT_HTTP_CATALOG_MAX_AGE_CAP=86400
# KEEPERSPORT_HTTP_STALE_WHILE_REVALIDATE=3600
# KEEPERSPORT_WARM_CATALOG_LOCALES=en,ar
# تسخين الكاش مرتين يومياً (موصى به) — يحتاج أيضاً: * * * * * php artisan schedule:run
# KEEPERSPORT_WARM_CATALOG_CRON=0 3,15 * * *
# أو ساعة واحدة: KEEPERSPORT_WARM_CATALOG_CRON=03:00
# أو off لتعطيل جدولة Laravel والاعتماد على cron مباشر فقط
# KEEPERSPORT_WARM_CATALOG_MEMORY_MB=1024
# كاش ناتج التسخين لـ 48 ساعة (يغطي يوم فشل cron)
# KEEPERSPORT_WARM_CACHE_TTL=172800
# بعد التصنيفات: أحدث N منتج (slug) يُخزَّن — 2000 مناسب كبداية
# KEEPERSPORT_WARM_PRODUCTS_LIMIT=2000
# KEEPERSPORT_WARM_PRODUCT_RECOMMENDED=false
# false = فتح المنتج سريع (لا ينتظر REST للمخزون ولا الموصى بها ولا fulltext)
# KEEPERSPORT_REST_STOCK_FETCH_ON_MISS=false
# KEEPERSPORT_RECOMMENDED_FETCH_ON_MISS=false
# true = إن لم يوجد المنتج بالكاش، بحث fulltext محدود (يمنع 404)
# KEEPERSPORT_PDP_FULLTEXT_LOOKUP=true
# KEEPERSPORT_PDP_DIRECT_GRAPHQL_LOOKUP=true
# KEEPERSPORT_PDP_REFRESH_QUANTITIES_ON_CACHE_HIT=false
#
# ── الطريقة ١: cron مباشر (موصى به — أنت تختار الساعة) ──
# استخدم السكربت لإنشاء اللوج وتشخيص الأخطاء:
# 0 3,15 * * * /bin/bash /home/keepersport/public_html/project/scripts/warm-catalog-cron.sh
#
# أو يدوياً بدون سكربت (يجب أن يوجد مجلد storage/logs وصلاحية كتابة):
# 0 3,15 * * * cd /home/keepersport/public_html/project && /usr/local/bin/php -d memory_limit=1024M artisan keepersport:warm-catalog-cache --products-limit=2000 >> storage/logs/catalog-warm.log 2>&1
#
# تحقق من اللوج:
# tail -50 /home/keepersport/public_html/project/storage/logs/catalog-warm.log
#
# إذا اللوج غير موجود = الأمر لم يُنفَّذ أصلاً (مسار خاطئ، php غير موجود، أو cron لم يشتغل)
#
# ── الطريقة ٢: جدولة Laravel (KEEPERSPORT_WARM_CATALOG_CRON) + هذا السطر كل دقيقة ──
# * * * * * cd /path/to/project && php artisan schedule:run >> /dev/null 2>&1
#
# يدوياً: php artisan keepersport:warm-catalog-cache --products-limit=2000 --memory=1024

# NeoLeap
# NEOLEAP_MODE=live
# NEOLEAP_HOSTED_URL=https://securepayments.neoleap.com.sa/pg/payment/hosted.htm
# إذا السيرفر ما يحل digitalpayments.neoleap.com.sa:
# NEOLEAP_HOSTED_URL=https://digitalpayments.alrajhibank.com.sa/pg/payment/hosted.htm
# NEOLEAP_TRANPORTAL_ID=
# NEOLEAP_TRANPORTAL_PASSWORD=
# NEOLEAP_RESOURCE_KEY=

# رقم الضريبة على فاتورة كيبرسبورت (ZATCA QR)
# KEEPERSPORT_VAT_NUMBER=300000000000003


# cd /home/keepersport/public_html/project
# php artisan migrate --force
# php artisan permissions:sync-dashboard-menus
